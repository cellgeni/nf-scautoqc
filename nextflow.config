def localSangerConfigPath = "${projectDir}/conf/sanger.config"
def siteSangerConfigPath = "/software/cellgen/cellgeni/nextflow/config/sanger.config"
def sangerConfigPath = [localSangerConfigPath, siteSangerConfigPath].find { new File(it.toString()).exists() }
def onSanger = new File(siteSangerConfigPath).exists()

def applySangerProfile(configPath) {
  includeConfig configPath

  params {
    container = params.sanger_container
  }

  singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "/nfs/cellgeni/singularity/images/"
  }

  process {
    container = params.sanger_container

    // Keep explicit GPU settings until the integration processes are labelled
    // with `label 'gpu'` in main.nf, which would let nf-core/sanger.config
    // handle GPU queues and options via its withLabel:gpu selector.
    withName: integrate {
      queue = {
        def requestedHpc = (params.sanger_gpu_hpc ?: 'farm22').toString().trim().toLowerCase()
        if (!['farm22', 'cub22'].contains(requestedHpc)) {
          throw new IllegalArgumentException("Invalid --sanger_gpu_hpc '${params.sanger_gpu_hpc}'. Choose 'farm22' or 'cub22'.")
        }
        if (requestedHpc == 'cub22') {
          def projectCode = (params.sanger_gpu_project ?: '').toString().trim()
          if (!(projectCode ==~ /^s.+/)) {
            throw new IllegalArgumentException("Using --sanger_gpu_hpc cub22 requires --sanger_gpu_project with a project cost code starting with 's'.")
          }
        }
        requestedHpc == 'cub22' ? 'cub22-inference' : 'gpu'
      }
      clusterOptions = {
        def requestedHpc = (params.sanger_gpu_hpc ?: 'farm22').toString().trim().toLowerCase()
        if (!['farm22', 'cub22'].contains(requestedHpc)) {
          throw new IllegalArgumentException("Invalid --sanger_gpu_hpc '${params.sanger_gpu_hpc}'. Choose 'farm22' or 'cub22'.")
        }
        if (requestedHpc == 'cub22') {
          def projectCode = (params.sanger_gpu_project ?: '').toString().trim()
          if (!(projectCode ==~ /^s.+/)) {
            throw new IllegalArgumentException("Using --sanger_gpu_hpc cub22 requires --sanger_gpu_project with a project cost code starting with 's'.")
          }
          return "-G ${projectCode} -gpu \"mode=shared:j_exclusive=no:gmem=16000:num=1\""
        }
        '-gpu "mode=shared:j_exclusive=no:gmem=16000:num=1"'
      }
    }
  }
}

params {
  // inputs/outputs
  SAMPLEFILE = ""
  ss_prefix = ""
  cb_prefix = ""
  cr_prefix = ""
  cellbender_input = "cellbender.h5"
  metrics_csv = ""
  metadata = ""
  path_for_scvi = ""
  project_tag = ""
  cell_or_nuclei = "cell"
  limits_csv = "${projectDir}/example_cutoffs_subset.csv" // Used in subset mode only

  // pipeline options
  min_frac = 0.5
  ss_out = "GeneFull"
  gather_mode = "cellbender" // Options: cellbender, starsolo
  gmm_cutoff = "inner"  // Options: inner, outer
  qc_mode = "original"       // Options: original, multires, combined
  celltypist_model = ""
  from_scautoqc = true
  n_top_genes = 7500
  batch_key = ""

  // Container image used by portable profiles.
  // Replace the tag once the production image is published.
  container = "quay.io/cellgeni/scautoqc:26-177"

  // Current Sanger/FARM SIF used by the existing config.
  // Kept as a separate parameter so FARM compatibility is explicit.
  sanger_container = "/nfs/cellgeni/singularity/images/scautoqc-v0.9.0.sif"

  // Sanger GPU host for integration steps. Use cub22 with a project cost code:
  // --sanger_gpu_hpc cub22 --sanger_gpu_project sXXXX
  sanger_gpu_hpc = "farm22"
  sanger_gpu_project = ""
}

process {
  container = params.container

  errorStrategy = { task.exitStatus == 130 ? 'retry' : 'terminate' }
  maxRetries    = 5

  withName: gather_matrices {
    cpus = 1
    memory = { 8.GB * task.attempt }
    maxForks = 10
  }

  withName: run_qc {
    cpus = 1
    memory = { 16.GB * task.attempt }
    maxForks = 10
  }

  withName: subset_object {
    cpus = 1
    memory = { 8.GB * task.attempt }
    maxForks = 10
  }

  withName: find_doublets {
    cpus = 1
    memory = { 8.GB * task.attempt }
    maxForks = 10
  }

  withName: pool_all {
    cpus = 1
  }

  withName: finalize_qc {
    cpus = 1
  }

  withName: finalize_qc_basic {
    cpus = 1
  }

  withName: integrate {
    cpus = 1
  }
}

profiles {
  standard {
    if (onSanger && sangerConfigPath) {
      applySangerProfile(sangerConfigPath)
    }
  }

  docker {
    docker {
      enabled = true
    }
  }

  singularity {
    singularity {
      enabled    = true
      autoMounts = true
    }
  }

  apptainer {
    apptainer {
      enabled    = true
      autoMounts = true
    }
  }

  sanger {
    if (!sangerConfigPath) {
      throw new IllegalStateException("Sanger profile requested, but no Sanger config was found")
    }

    applySangerProfile(sangerConfigPath)
  }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Capturing Nextflow log files into a reports directory
def timestamp = new java.util.Date().format('yyyyMMdd_HHmm')
timeline {
  enabled = true
  file = "scautoqc-reports-${params.project_tag}/timeline_${timestamp}.html"
}

report {
  enabled = true
  file = "scautoqc-reports-${params.project_tag}/report_${timestamp}.html"
}

trace {
  enabled = true
  file = "scautoqc-reports-${params.project_tag}/trace-${timestamp}.txt"
  fields = "task_id,hash,name,status,exit,submit,duration,realtime,%cpu,memory,%mem,peak_rss,peak_vmem"
}

workDir = "nf-work"
